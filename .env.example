# wikijs-mcp settings. In production: copy to /opt/wikijs-mcp/.env (mode 600).
# Durations accept s, m, h, d (e.g. 30m, 14d) or plain seconds.

# --- Required -------------------------------------------------------------

# Wiki.js as seen from the MCP server (same LXC: localhost and Wiki.js's port)
WIKIJS_URL=http://127.0.0.1:3000

# The public address of the wiki, as users open it (the MCP server is at /mcp/)
WIKIJS_PUBLIC_URL=https://wiki.example.com

# Key of the Wiki.js login strategy users sign in with (Admin > Authentication;
# it is also the last part of the login button's link: /login/<key>)
WIKIJS_STRATEGY_KEY=00000000-0000-0000-0000-000000000000

# SQLite database for users, tokens and sessions
WIKIJS_MCP_DB_PATH=/opt/wikijs-mcp/data/mcp.sqlite

# Encrypts the stored Wiki.js sessions. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every connected app ask its user to sign in again.
WIKIJS_MCP_ENCRYPTION_KEY=

# --- Network --------------------------------------------------------------

# Address and port to listen on. The proxy runs in another LXC container, so
# listen on this container's address (or 0.0.0.0 with a firewall).
WIKIJS_MCP_HOST=0.0.0.0
WIKIJS_MCP_PORT=8000
# Only trust X-Forwarded-* headers from the reverse proxy (its IP address)
WIKIJS_MCP_FORWARDED_ALLOW_IPS=10.0.0.2
# Path under the wiki's address where the MCP server lives
WIKIJS_MCP_BASE_PATH=/mcp

# --- Behaviour ------------------------------------------------------------

# true: only reading tools. false: also create/update/delete/move pages
# (Wiki.js still enforces each user's rights)
WIKIJS_MCP_READ_ONLY=true

# Must match Admin > Security > "Token Renewal Period" in Wiki.js
WIKIJS_TOKEN_RENEWAL=14d

# After this long since their last sign-in, connected apps ask users to sign in
# again (through the wiki's login)
WIKIJS_MCP_SESSION_MAX_AGE=30d

# Optional: default locale (otherwise taken from Wiki.js)
#WIKIJS_DEFAULT_LOCALE=en

# Optional: timeout for reading page sources from Wiki.js, in seconds
#WIKIJS_HTML_TIMEOUT=10

#DEBUG=false
